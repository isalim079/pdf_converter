NODE_ENV=development
PORT=3050
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Format: key:ownerId:keyId,key2:owner2:keyId2
API_KEYS=dev-local-key:org_local:key_local

DATABASE_URL=postgresql://pdf:pdf@localhost:5432/pdf_service
REDIS_URL=redis://localhost:6379
GOTENBERG_URL=http://localhost:3000
GOTENBERG_REQUIRED=false
# Host ports for Compose. Ensure remaps these when the defaults belong to another app.
# PDF_POSTGRES_PORT=5432
# PDF_REDIS_PORT=6379
# PDF_GOTENBERG_PORT=3000
# Linux host binary. yarn start spawns it unless GOTENBERG_URL is already healthy.
# GOTENBERG_BIN=/usr/local/bin/gotenberg

PUBLIC_URL=http://localhost:3050
# Use fs when running `yarn dev` without MinIO/Docker. Use s3 in compose/production.
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=/tmp/pdf-service-objects

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pdf-service
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me-minio-secret
S3_FORCE_PATH_STYLE=true

PDF_MAX_FILE_SIZE_MB=25
PDF_MAX_PAGES=300
PDF_JOB_TIMEOUT_SECONDS=120
PDF_WORKER_CONCURRENCY=2
PDF_MAX_CONCURRENT_JOBS=2
PDF_MAX_QUEUE_DEPTH=100
PDF_JOB_RETENTION_HOURS=24
PDF_INPUT_RETENTION_HOURS=24
PDF_TEMP_DIR=/tmp/pdf-service
PDF_SYNC_MAX_FILE_SIZE_MB=5
PDF_SYNC_MAX_PAGES=30
PDF_SYNC_TIMEOUT_SECONDS=30

SIGNED_URL_EXPIRES_SECONDS=900

API_RATE_LIMIT_MAX=30
API_RATE_LIMIT_WINDOW_SECONDS=60

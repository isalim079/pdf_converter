NODE_ENV=development
PORT=3050
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Optional. yarn start detects and writes these when LibreOffice / Chrome are installed.
# LIBREOFFICE_BIN=/Applications/LibreOffice.app/Contents/MacOS/soffice
# CHROMIUM_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
ENGINES_REQUIRED=false

PDF_MAX_FILE_SIZE_MB=25
PDF_MAX_PAGES=300
PDF_JOB_TIMEOUT_SECONDS=120
PDF_MAX_CONCURRENT_JOBS=2
PDF_MAX_HTML_ASSETS=32
PDF_TEMP_DIR=/tmp/pdf-service

API_RATE_LIMIT_MAX=30
API_RATE_LIMIT_WINDOW_SECONDS=60

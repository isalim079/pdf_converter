{
  "name": "pdf-converter-api",
  "version": "1.0.0",
  "private": true,
  "description": "Document-to-PDF conversion API",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/ensure-runtime.mjs --boot=dev",
    "dev:api": "tsx watch src/main.ts",
    "infra": "bash scripts/infra.sh",
    "install:linux": "bash scripts/install-linux.sh",
    "ensure": "node scripts/ensure-runtime.mjs --boot=none",
    "build": "tsc -p tsconfig.build.json",
    "start": "node scripts/ensure-runtime.mjs --boot=start",
    "start:api": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/generate-fixtures.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "close-with-grace": "^2.2.0",
    "fastify": "^5.6.1",
    "file-type": "^21.0.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.11.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.34.4",
    "ulid": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}

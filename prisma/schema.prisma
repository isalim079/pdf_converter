generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PdfJobStatus {
  queued
  processing
  completed
  failed
  cancelled
  expired
}

model PdfJob {
  id               String       @id
  status           PdfJobStatus
  ownerId          String
  apiKeyId         String?

  originalFilename String
  inputMimeType    String
  inputSize        BigInt
  inputStorageKey  String

  outputStorageKey String?
  outputMimeType   String?
  outputSize       BigInt?
  pageCount        Int?

  conversionEngine String?
  pageSize         String?
  orientation      String?
  options          Json?

  attempts         Int          @default(0)
  errorCode        String?
  errorMessage     String?

  createdAt        DateTime     @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  expiresAt        DateTime?

  idempotency      IdempotencyRecord?

  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([ownerId, status])
  @@map("pdf_jobs")
}

model IdempotencyRecord {
  ownerId     String
  key         String
  jobId       String   @unique
  requestHash String
  createdAt   DateTime @default(now())
  job         PdfJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([ownerId, key])
  @@map("idempotency_records")
}

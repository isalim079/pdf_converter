[Unit]
Description=PDF conversion API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pdf-converter-api
EnvironmentFile=/opt/pdf-converter-api/.env
ExecStart=/usr/bin/node dist/start.js
Restart=on-failure
RestartSec=5
User=pdf
Group=pdf
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
